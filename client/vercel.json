{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/#/admin",
      "permanent": false
    },
    {
      "source": "/admin/dashboard",
      "destination": "/#/admin/dashboard",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
