{
  "version": 2,
  "functions": {
    "server/server.js": {
      "runtime": "vercel-node@latest"
    }
  },
  "redirects": [
    {
      "source": "/admin",
      "destination": "/#/admin",
      "permanent": false
    },
    {
      "source": "/admin/dashboard",
      "destination": "/#/admin/dashboard",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/server.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/server/server.js"
    },
    {
      "source": "/:path*\\.:ext",
      "destination": "/client/dist/:path*\\.:ext"
    },
    {
      "source": "/(.*)",
      "destination": "/client/dist/index.html"
    }
  ]
}
